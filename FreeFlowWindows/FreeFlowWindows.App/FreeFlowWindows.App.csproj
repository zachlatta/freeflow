<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FreeFlow</AssemblyName>
    <RootNamespace>FreeFlowWindows.App</RootNamespace>
    
    <!-- Application metadata -->
    <Product>FreeFlow</Product>
    <Company>FreeFlow</Company>
    <Copyright>Copyright © 2024-2026 FreeFlow Contributors. MIT License.</Copyright>
    <Description>Free and open source voice dictation app with AI transcription</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    
    <!-- Application icon -->
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    
    <!-- Publishing settings -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    
    <!-- Trim unused code for smaller file size -->
    <PublishTrimmed>false</PublishTrimmed>
    
    <!-- Ready to run for faster startup -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FreeFlowWindows.Core\FreeFlowWindows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\*.ico" />
    <None Remove="Resources\*.png" />
    <Resource Include="Resources\*.ico" Condition="Exists('Resources')" />
    <Resource Include="Resources\*.png" Condition="Exists('Resources')" />
  </ItemGroup>

</Project>
