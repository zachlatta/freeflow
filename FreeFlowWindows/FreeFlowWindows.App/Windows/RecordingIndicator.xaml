<Window x:Class="FreeFlowWindows.App.Windows.RecordingIndicator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:FreeFlowWindows.App.ViewModels"
        xmlns:local="clr-namespace:FreeFlowWindows.App.Windows"
        mc:Ignorable="d"
        Title="Recording"
        Width="92"
        Height="38"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False"
        d:DataContext="{d:DesignInstance Type=viewmodels:RecordingIndicatorViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <!-- macOS-matching colors: white waveform on black background -->
        <SolidColorBrush x:Key="WaveformBrush" Color="White"/>
        <SolidColorBrush x:Key="ProcessingBrush" Color="White"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#E94545"/>
        <SolidColorBrush x:Key="IndicatorBackgroundBrush" Color="#FF000000"/>

        <!-- Converters -->
        <local:AudioLevelToHeightConverter x:Key="AudioLevelToHeight"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Pulsing dot animation for initializing state (macOS InitializingDotsView) -->
        <Storyboard x:Key="InitializingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Dot1" 
                           Storyboard.TargetProperty="Opacity"
                           From="0.25" To="0.9" Duration="0:0:0.4" 
                           AutoReverse="True" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="Dot2" 
                           Storyboard.TargetProperty="Opacity"
                           From="0.25" To="0.9" Duration="0:0:0.4" 
                           AutoReverse="True" BeginTime="0:0:0.5"/>
            <DoubleAnimation Storyboard.TargetName="Dot3" 
                           Storyboard.TargetProperty="Opacity"
                           From="0.25" To="0.9" Duration="0:0:0.4" 
                           AutoReverse="True" BeginTime="0:0:1.0"/>
        </Storyboard>

        <!-- Processing bars animation (macOS ProcessingWaveformView) -->
        <Storyboard x:Key="ProcessingAnimation" RepeatBehavior="Forever">
            <!-- Bar 1: edge bar -->
            <DoubleAnimation Storyboard.TargetName="ProcessBar1" Storyboard.TargetProperty="Height"
                           From="4" To="12" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="ProcessBar1" Storyboard.TargetProperty="Opacity"
                           From="0.42" To="0.94" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0"/>
            <!-- Bar 2 -->
            <DoubleAnimation Storyboard.TargetName="ProcessBar2" Storyboard.TargetProperty="Height"
                           From="6" To="14" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.11"/>
            <DoubleAnimation Storyboard.TargetName="ProcessBar2" Storyboard.TargetProperty="Opacity"
                           From="0.42" To="0.94" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.11"/>
            <!-- Bar 3: center bar -->
            <DoubleAnimation Storyboard.TargetName="ProcessBar3" Storyboard.TargetProperty="Height"
                           From="8" To="18" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="ProcessBar3" Storyboard.TargetProperty="Opacity"
                           From="0.42" To="0.94" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.22"/>
            <!-- Bar 4 -->
            <DoubleAnimation Storyboard.TargetName="ProcessBar4" Storyboard.TargetProperty="Height"
                           From="6" To="14" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.33"/>
            <DoubleAnimation Storyboard.TargetName="ProcessBar4" Storyboard.TargetProperty="Opacity"
                           From="0.42" To="0.94" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.33"/>
            <!-- Bar 5: edge bar -->
            <DoubleAnimation Storyboard.TargetName="ProcessBar5" Storyboard.TargetProperty="Height"
                           From="4" To="12" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.44"/>
            <DoubleAnimation Storyboard.TargetName="ProcessBar5" Storyboard.TargetProperty="Opacity"
                           From="0.42" To="0.94" Duration="0:0:1.05" AutoReverse="True" BeginTime="0:0:0.44"/>
        </Storyboard>
    </Window.Resources>

    <!-- macOS-style pill: black background with rounded bottom corners only (UnevenRoundedRectangle) -->
    <Border CornerRadius="0,0,12,12"
            Background="{StaticResource IndicatorBackgroundBrush}"
            Cursor="Hand"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" 
                             ShadowDepth="2" 
                             Opacity="0.3"
                             Color="Black"/>
        </Border.Effect>

        <Grid Margin="12,0">
            <!-- Centered content -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Initializing state: 3 pulsing dots (macOS InitializingDotsView) -->
                <StackPanel x:Name="InitializingPanel"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}">
                    <Ellipse x:Name="Dot1" Width="4.5" Height="4.5" Fill="White" Opacity="0.25" Margin="2,0"/>
                    <Ellipse x:Name="Dot2" Width="4.5" Height="4.5" Fill="White" Opacity="0.25" Margin="2,0"/>
                    <Ellipse x:Name="Dot3" Width="4.5" Height="4.5" Fill="White" Opacity="0.25" Margin="2,0"/>
                </StackPanel>

                <!-- Recording state: 9-bar waveform (macOS WaveformView) -->
                <!-- barCount=9, multipliers=[0.35,0.55,0.75,0.9,1.0,0.9,0.75,0.55,0.35], spacing=2.5, width=3, minHeight=2, maxHeight=22 -->
                <StackPanel x:Name="RecordingPanel"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Height="24"
                           Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}">
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar1, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar2, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar3, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar4, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar5, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar6, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar7, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar8, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                    <Border Width="3" Margin="1.25,0" CornerRadius="1.5" VerticalAlignment="Center"
                           Background="{StaticResource WaveformBrush}"
                           Height="{Binding AudioBar9, Converter={StaticResource AudioLevelToHeight}, ConverterParameter=22}"/>
                </StackPanel>

                <!-- Processing state: 5 animated bars (macOS ProcessingWaveformView) -->
                <!-- spacing=4, width=4, minHeight=4, maxHeight=18 -->
                <StackPanel x:Name="ProcessingPanel"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Height="20"
                           Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                    <Border x:Name="ProcessBar1" Width="4" Margin="2,0" CornerRadius="2" VerticalAlignment="Center"
                           Background="{StaticResource ProcessingBrush}" Height="4" Opacity="0.42"/>
                    <Border x:Name="ProcessBar2" Width="4" Margin="2,0" CornerRadius="2" VerticalAlignment="Center"
                           Background="{StaticResource ProcessingBrush}" Height="6" Opacity="0.42"/>
                    <Border x:Name="ProcessBar3" Width="4" Margin="2,0" CornerRadius="2" VerticalAlignment="Center"
                           Background="{StaticResource ProcessingBrush}" Height="8" Opacity="0.42"/>
                    <Border x:Name="ProcessBar4" Width="4" Margin="2,0" CornerRadius="2" VerticalAlignment="Center"
                           Background="{StaticResource ProcessingBrush}" Height="6" Opacity="0.42"/>
                    <Border x:Name="ProcessBar5" Width="4" Margin="2,0" CornerRadius="2" VerticalAlignment="Center"
                           Background="{StaticResource ProcessingBrush}" Height="4" Opacity="0.42"/>
                </StackPanel>

                <!-- Error state: Red X icon (macOS FailureIndicatorView) -->
                <!-- Circle size=20, X size=12 -->
                <Grid x:Name="ErrorIcon"
                     Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                    <Ellipse Width="20" Height="20" Fill="{StaticResource ErrorBrush}" Opacity="0.92"/>
                    <Path Data="M6,6 L14,14 M14,6 L6,14" 
                         Stroke="White" StrokeThickness="2"
                         Width="20" Height="20"
                         HorizontalAlignment="Center" 
                         VerticalAlignment="Center"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"/>
                </Grid>
            </Grid>

            <!-- Stop button for Toggle mode (matching macOS) - positioned on right -->
            <!-- Circle=14x14, stop.fill icon=7pt -->
            <Button x:Name="StopButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="14" Height="14"
                    Margin="0,0,0,0"
                    Visibility="{Binding ShowStopButton, Converter={StaticResource BoolToVis}}"
                    Click="StopButton_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#E94545" Opacity="0.92"/>
                            <Rectangle Width="5" Height="5" Fill="White" RadiusX="0.5" RadiusY="0.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
